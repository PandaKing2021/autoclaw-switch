{
  "name": "autoclaw-zcode-console",
  "version": "1.0.0",
  "description": "All-in-One 反代平台控制台：AutoClaw / WorkBuddy / Trae 三平台额度接入 ZCode",
  "author": "PandaKing2021",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:dir": "electron-builder --win --x64 --dir"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.aswitch.console",
    "productName": "A-SWITCH Console",
    "directories": { "output": "dist", "buildResources": "build" },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "main.js",
      "preload.js",
      "zcode-config.js",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "../bridge", "to": "bridge", "filter": ["**/*", "!*.png"] },
      { "from": "../trae/relay.mjs", "to": "trae/relay.mjs" },
      { "from": "../trae/decrypt_auth.py", "to": "trae/decrypt_auth.py" },
      { "from": "../doubao/relay.mjs", "to": "doubao/relay.mjs" },
      { "from": "../doubao/cdp.js", "to": "doubao/cdp.js" },
      { "from": "../doubao/decrypt_cookies.py", "to": "doubao/decrypt_cookies.py" },
      { "from": "../autoclaw-switch/a_switch.py", "to": "autoclaw-switch/a_switch.py" },
      { "from": "../workbuddy/workbuddy-manager-v1.0.79/upstream/wb2api.exe", "to": "workbuddy/wb2api.exe" },
      { "from": "../workbuddy/workbuddy-manager-v1.0.79/upstream/wb2api-login.exe", "to": "workbuddy/wb2api-login.exe" },
      { "from": "../workbuddy/workbuddy-manager-v1.0.79/upstream/config.json", "to": "workbuddy/config.json" }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "A-SWITCH Console",
      "artifactName": "A-SWITCH-Console-Setup-${version}.exe"
    },
    "portable": { "artifactName": "A-SWITCH-Console-Portable-${version}.exe" }
  }
}
